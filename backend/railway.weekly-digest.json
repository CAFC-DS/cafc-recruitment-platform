{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "python tools/weekly_digest.py --scheduled",
    "cronSchedule": "0 6,7 * * 1",
    "restartPolicyType": "NEVER",
    "healthcheckPath": null,
    "numReplicas": 1
  }
}
